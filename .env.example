# Copy to .env and adjust. These values are safe defaults for local development.
AURALITH_ENV=development
AURALITH_DATA_DIR=./data
AURALITH_DB_URL=sqlite:///./data/auralith.db
AURALITH_STORAGE_DIR=./data/music
AURALITH_STORAGE_PROVIDER=local
# Run several backends at once (replicated writes, fallback reads). JSON list:
# AURALITH_STORAGE_PROVIDERS='[{"type":"gdrive"},{"type":"gdrive"},{"type":"neon"}]'
# With several providers, false writes only to the first backend that accepts it.
AURALITH_STORAGE_MIRROR=true

AURALITH_OWNER_USERNAME=owner
AURALITH_OWNER_PASSWORD=
AURALITH_RESET_OWNER_PASSWORD=false

# Signs media URLs (audio and artwork). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is generated per process and links die on restart.
AURALITH_MEDIA_SECRET=
AURALITH_MEDIA_URL_TTL_SECONDS=21600

AURALITH_CORS_ORIGINS=http://localhost:5173
AURALITH_ALLOW_VERCEL_ORIGINS=false
# Behind a reverse proxy that sets X-Forwarded-For, list its addresses here.
# Loopback and private ranges are trusted by default.
AURALITH_TRUSTED_PROXIES=

AURALITH_COOKIE_SECURE=false
AURALITH_COOKIE_SAMESITE=lax
AURALITH_ALLOW_INSECURE_COOKIES=true

SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy compatibility: SUPABASE_SERVICE_ROLE_KEY is deprecated.
SUPABASE_STORAGE_BUCKET=music

# Google Drive as storage: AURALITH_STORAGE_PROVIDER=gdrive
# Create an OAuth client (Desktop app) and a refresh token with the Drive scope.
AURALITH_GDRIVE_CLIENT_ID=
AURALITH_GDRIVE_CLIENT_SECRET=
AURALITH_GDRIVE_REFRESH_TOKEN=
AURALITH_GDRIVE_FOLDER_ID=

NEON_URL=
NEON_STORAGE_BUCKET=music
NEON_ACCESS_KEY_ID=
NEON_SECRET_ACCESS_KEY=
NEON_STORAGE_REGION=us-east-1
# Neon S3 panel values can also use the standard AWS names:
# AWS_ENDPOINT_URL_S3=
# AWS_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=
