AURALITH_DB_URL=sqlite:///./data/auralith.db
AURALITH_STORAGE_DIR=./data/music
AURALITH_OWNER_USERNAME=owner
AURALITH_OWNER_PASSWORD=
AURALITH_RESET_OWNER_PASSWORD=false
AURALITH_SESSION_SECRET=replace-with-a-long-random-secret
AURALITH_DB_PROVIDER=sqlalchemy
AURALITH_STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy compatibility: SUPABASE_SERVICE_ROLE_KEY is deprecated.
SUPABASE_STORAGE_BUCKET=music
AURALITH_CORS_ORIGINS=http://localhost:5173
AURALITH_COOKIE_SECURE=false
AURALITH_ALLOW_INSECURE_COOKIES=true
AURALITH_ENV=development
